    "Built on Chromium or Electron, which draws a blank window on DXMT and correctly on DXVK.": {
      "localizations": {
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Chromium yoki Electron asosida: DXMT'da bo'sh oyna, DXVK'da to'g'ri chiziladi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основано на Chromium или Electron: в DXMT окно пустое, в DXVK рисуется правильно."
          }
        }
      }
    },
    "C: Drive": {
      "localizations": {
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "C: disk"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диск C:"
          }
        }
      }
