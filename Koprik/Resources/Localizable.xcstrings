    "Drop a Windows .exe anywhere in this window, or install software from the sidebar.": {
      "localizations": {
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows .exe faylini shu oynaning istalgan joyiga tashlang yoki yon paneldan dastur o'rnating."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите .exe в любое место окна или установите программу из боковой панели."
          }
        }
      }
    },
    "Drop it anywhere in this window, or choose the file. A snapshot is saved first, so an install that goes wrong can be undone.": {
      "localizations": {
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Uni shu oynaga tashlang yoki faylni tanlang. Avval snapshot saqlanadi, shuning uchun xato ketgan o'rnatishni ortga qaytarsa bo'ladi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите его в окно или выберите файл. Сначала сохраняется снимок, так что неудачную установку можно отменить."
          }
        }
      }
    },
    "Duplicate": {
