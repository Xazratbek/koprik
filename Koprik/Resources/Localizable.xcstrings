    "Cancel": {
      "localizations": {
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekor qilish"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмена"
          }
        }
      }
    },
    "Caps the frame rate in DXMT and DXVK. A cap at the display's refresh rate gives the smoothest motion.": {
      "localizations": {
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "DXMT va DXVK'da kadrlar tezligini cheklaydi. Ekran chastotasiga teng chegara eng silliq harakatni beradi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ограничивает частоту кадров в DXMT и DXVK. Предел, равный частоте экрана, даёт самое плавное движение."
          }
        }
      }
    },
    "Check Again": {
      "localizations": {
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qayta tekshirish"
          }
        },
