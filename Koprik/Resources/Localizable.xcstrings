    "Create a bottle first, then open the file again.": {
      "localizations": {
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Avval bottle yarating, keyin faylni qayta oching."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала создайте бутылку, затем откройте файл снова."
          }
