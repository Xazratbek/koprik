    "DXMT only. Renders at a lower resolution and lets Apple's MetalFX upscale it. More frames in demanding games.": {
      "localizations": {
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Faqat DXMT. Pastroq aniqlikda chizadi, Apple MetalFX esa kattalashtiradi. Og'ir o'yinlarda ko'proq kadr."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только DXMT. Рендерит в меньшем разрешении, а MetalFX от Apple увеличивает изображение. Больше кадров в тяжёлых играх."
          }
        }
      }
    },
    "DXVK Frame Rate HUD": {
      "localizations": {
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "DXVK kadr tezligi HUD"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "HUD частоты кадров DXVK"
          }
        }
      }
    },
    "DXVK async shaders": {
      "localizations": {
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "DXVK asinxron sheyderlar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Асинхронные шейдеры DXVK"
          }
        }
      }
    },
    "Data folder": {
      "localizations": {
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma'lumotlar papkasi"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка данных"
          }
        }
      }
    },
    "Default (%@)": {
      "localizations": {
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Sukut (%@)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию (%@)"
          }
        }
      }
    },
    "Direct3D 10/11 to Metal. The default for most games.": {
      "localizations": {
        "uz": {
          "stringUnit": {
            "state": "translated",
